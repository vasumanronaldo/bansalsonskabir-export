# Bansal Sons Jewellers — environment (docs/03 § Environment).
# Copy to .env.local; never commit real values.

# Sanity CMS (Phase 3) — get the project id from sanity.io after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Resend transactional email + newsletter (Phase 5 / 8)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
APPOINTMENT_NOTIFY_EMAIL=bansalsonsjewellers18@gmail.com

# Public site URL
NEXT_PUBLIC_SITE_URL=https://bansalsonsjewellers.com
