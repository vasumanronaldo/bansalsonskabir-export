{
  "name": "bansal-sons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "content:status": "node scripts/content-status.mjs",
    "content:edit": "bash scripts/content-edit.sh",
    "content:push": "node scripts/content-push.mjs",
    "prebuild": "node scripts/content-status.mjs",
    "check:launch": "node scripts/content-status.mjs --strict && pnpm typecheck && pnpm build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "admin:migrate": "wrangler d1 execute bansal-sons-admin --remote --file=admin/schema.sql",
    "admin:user:add": "node scripts/admin-user-add.mjs",
    "admin:seed": "node scripts/admin-seed.mjs",
    "admin:backup": "node scripts/admin-backup.mjs",
    "admin:user:reset": "node scripts/admin-user-reset.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@portabletext/react": "^7.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^3.99.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^11.18.2",
    "next": "15.5.4",
    "next-sanity": "^13.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "sanity": "^3.99.0",
    "styled-components": "^6.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/eslintrc": "3.2.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.10.10",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.4",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.1.14",
    "typescript": "5.7.3",
    "wrangler": "^4.119.0"
  }
}
