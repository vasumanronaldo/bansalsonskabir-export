{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bansal-sons",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bansal-sons-admin",
      "database_id": "ded40c57-30c2-419e-a96c-b8797be116ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bansal-sons-images"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "6705lek2",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "SANITY_API_VERSION": "2024-01-01"
  }
}
